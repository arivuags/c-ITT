#include <stdbool.h>

bool isPossibleToSplit(int* nums, int numsSize) {
    // Array to count the frequency of each element (1 <= nums[i] <= 100)
    int count[101] = {0};
    
    for (int i = 0; i < numsSize; i++) {
        count[nums[i]]++;
        
        // If an element appears more than 2 times, it cannot be distributed 
        // into 2 sets of distinct elements.
        if (count[nums[i]] > 2) {
            return false;
        }
    }
    
    return true;
}

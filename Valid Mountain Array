#include <stdbool.h>

bool validMountainArray(int* arr, int arrSize) {
    // A mountain array must have at least 3 elements
    if (arrSize < 3) {
        return false;
    }
    
    int i = 0;
    
    // Climb up the mountain (strictly increasing)
    while (i + 1 < arrSize && arr[i] < arr[i + 1]) {
        i++;
    }
    
    // The peak cannot be the first element (it never climbed) 
    // or the last element (it never descended)
    if (i == 0 || i == arrSize - 1) {
        return false;
    }
    
    // Walk down the mountain (strictly decreasing)
    while (i + 1 < arrSize && arr[i] > arr[i + 1]) {
        i++;
    }
    
    // If we successfully reached the end of the array, it's a valid mountain
    return i == arrSize - 1;
}



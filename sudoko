#include <stdbool.h>

bool isValidSudoku(char** board, int boardSize, int* boardColSize) {
    // Array of bitmasks initialized to 0
    // Index tracks row/col/box number; bit value tracks digits 1-9
    int rows[9] = {0};
    int cols[9] = {0};
    int boxes[9] = {0};
    
    for (int r = 0; r < 9; r++) {
        for (int c = 0; c < 9; c++) {
            char current = board[r][c];
            
            // Skip empty cells
            if (current == '.') {
                continue;
            }
            
            // Convert character digit '1'-'9' to a 0-indexed integer 1-9
            int val = current - '0';
            int mask = 1 << val;
            
            // Calculate which 3x3 sub-box the cell belongs to
            int box_index = (r / 3) * 3 + (c / 3);
            
            // Check for duplicates using bitwise AND
            if ((rows[r] & mask) || (cols[c] & mask) || (boxes[box_index] & mask)) {
                return false;
            }
            
            // Mark the digit as seen using bitwise OR
            rows[r] |= mask;
            cols[c] |= mask;
            boxes[box_index] |= mask;
        }
    }
    
    return true;
}

#include <stdio.h>

void swap(int* a, int* b) {
    int temp = *a;
    *a = *b;
    *b = temp;
}

int firstMissingPositive(int* nums, int numsSize) {
    for (int i = 0; i < numsSize; i++) {
        // Rearrange numbers to their correct positions: nums[i] should be at index nums[i] - 1
        // We only care about positive numbers within the array bounds [1, numsSize]
        while (nums[i] > 0 && nums[i] <= numsSize && nums[nums[i] - 1] != nums[i]) {
            swap(&nums[i], &nums[nums[i] - 1]);
        }
    }
    
    // Find the first index where the expected number is missing
    for (int i = 0; i < numsSize; i++) {
        if (nums[i] != i + 1) {
            return i + 1;
        }
    }
    
    // If all numbers from 1 to numsSize are present, the answer is numsSize + 1
    return numsSize + 1;
}

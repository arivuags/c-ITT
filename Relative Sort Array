#include <stdio.h>
#include <stdlib.h>
#include <string.h>

/**
 * Note: The returned array must be dynamically allocated, and the caller 
 * must free the memory. *returnSize is updated with the size of the returned array.
 */
int* relativeSortArray(int* arr1, int arr1Size, int* arr2, int arr2Size, int* returnSize) {
    // Define the frequency bucket array based on the given constraints (0 <= arr1[i] <= 1000)
    int freq[1001] = {0};
    
    // Step 1: Count the frequency of each element in arr1
    for (int i = 0; i < arr1Size; i++) {
        freq[arr1[i]]++;
    }
    
    // Allocate memory for the final sorted result array
    int* result = (int*)malloc(arr1Size * sizeof(int));
    int index = 0;
    
    // Step 2: Place elements of arr1 into the result matching the order of arr2
    for (int i = 0; i < arr2Size; i++) {
        int element = arr2[i];
        while (freq[element] > 0) {
            result[index++] = element;
            freq[element]--;
        }
    }
    
    // Step 3: Append all elements that did not appear in arr2 in ascending order
    for (int i = 0; i <= 1000; i++) {
        while (freq[i] > 0) {
            result[index++] = i;
            freq[i]--;
        }
    }
    
    *returnSize = arr1Size;
    return result;
}

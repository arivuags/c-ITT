#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define MOD 1000000007

int numberOfArrays(char* s, int k) {
    int n = strlen(s);
    
    // Allocate dp array of size n + 1
    // dp[i] stores the number of valid arrays for the suffix s[i...n-1]
    int* dp = (int*)calloc(n + 1, sizeof(int));
    
    // Base case: an empty suffix has exactly 1 valid partition
    dp[n] = 1;
    
    // Traverse the string backwards from the last character
    for (int i = n - 1; i >= 0; i--) {
        // Condition: No number in the array can have leading zeros
        if (s[i] == '0') {
            dp[i] = 0;
            continue;
        }
        
        long long currentNum = 0;
        
        // Form numbers starting at index i up to a maximum of 10 digits
        for (int j = i; j < n; j++) {
            currentNum = currentNum * 10 + (s[j] - '0');
            
            // If the formed number exceeds k, any longer number will also exceed k
            if (currentNum > k) {
                break;
            }
            
            // Add the combinations from the remaining suffix
            dp[i] = (dp[i] + dp[j + 1]) % MOD;
        }
    }
    
    int result = dp[0];
    free(dp); // Clean up allocated memory
    
    return result;
}

#include <stdio.h>

int removeElement(int* nums, int numsSize, int val) {
    // Pointer to place the elements that are not equal to val
    int k = 0;
    
    // Traverse the array
    for (int i = 0; i < numsSize; i++) {
        // If the current element is not the target value
        if (nums[i] != val) {
            nums[k] = nums[i];
            k++;
        }
    }
    
    // k represents the count of elements remaining
    return k;
}

typedef struct {
    int *data;
    int size;
    int max_size;
} CustomStack;


CustomStack* customStackCreate(int max_size) {
    CustomStack* stack = (CustomStack*) malloc(sizeof (CustomStack));
    stack->data = (int*) malloc(max_size * sizeof (int));
    stack->size = 0;
    stack->max_size = max_size;
    return stack;
}

void customStackPush(CustomStack* stack, int x) {
    if (stack->size < stack->max_size) {
        stack->data[stack->size] = x;
        stack->size++;
    }
}

int customStackPop(CustomStack* stack) {
    if (stack->size > 0) {
        stack->size--;
        return stack->data[stack->size];
    }
    return -1;
}


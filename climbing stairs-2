// step 1
int minCost(int a, int b, int c) {
    if (a <= b && a <= c) {
        return a;
    } else if (b <= a && b <= c) {
        return b;
    } else {
        return c;
    }
}

int stepCost(int i, int j, int* costs) {
    return costs[j] + (j - i)*(j - i);
}

// step 2
int climbStairsSubset(int start, int end, int* costs) {
    if (start == end) {
        return 0;
    }

    if (end - start == 1) {
        return stepCost(start, end, costs);
    }

    if (end - start == 2) {
        int cost1 = stepCost(start, start + 1, costs) + stepCost(start + 1, end, costs);
        int cost2 = stepCost(start, end, costs);
        return (cost1 < cost2 ? cost1 : cost2);
    }

    int cost1 = stepCost(start, start + 1, costs) + climbStairsSubset(start + 1, end, costs);
    int cost2 = stepCost(start, start + 2, costs) + climbStairsSubset(start + 2, end, costs);
    int cost3 = stepCost(start, start + 3, costs);

    return minCost(cost1, cost2, cost3);
}

// steps 3-6
int climbStairs(int n, int* costs, int costsSize) {
    // edge case
    if (n < 2) {
        return climbStairsSubset(-1, n - 1, costs);
    }

    // step 3
    int minCosts[] = {
        0,
        stepCost(-1, 0, costs),
        climbStairsSubset(-1, 1, costs)
    };

    int cost, cost1, cost2, cost3;
    for (int i = 2; i < n; i++) {
        // step 4
        cost1 = minCosts[2] + stepCost(i - 1, i, costs);
        cost2 = minCosts[1] + stepCost(i - 2, i, costs);
        cost3 = minCosts[0] + stepCost(i - 3, i, costs);
        cost = minCost(cost1, cost2, cost3);

        // step 5
        minCosts[0] = minCosts[1];
        minCosts[1] = minCosts[2];
        minCosts[2] = cost;
    }

    // step 6
    return minCosts[2];
}
